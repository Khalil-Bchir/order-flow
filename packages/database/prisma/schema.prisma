generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String   @db.Text()
  role       Role
  code       String
  create_at  DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([email])
}

enum Role {
  ADMIN
  USER
  MODERATOR
}
